# Matugen template for btop — pinned sat/lightness so Material pastels cannot wash out.

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"
# All graphs and meters can be gradients (start / mid / end).

# Main background, empty for terminal default (Kitty frosted glass)
theme[main_bg]=""

<* if {{ is_dark_mode }} *>
theme[main_fg]="{{ colors.on_surface.default.hex }}"
theme[title]="{{ colors.primary.default.hex | set_saturation: 78.0 | set_lightness: 72.0 }}"
theme[hi_fg]="{{ colors.primary.default.hex | set_saturation: 80.0 | set_lightness: 55.0 }}"
theme[selected_bg]="{{ colors.primary.default.hex | set_saturation: 82.0 | set_lightness: 68.0 }}"
theme[selected_fg]="{{ colors.primary.default.hex | set_saturation: 45.0 | set_lightness: 18.0 }}"
theme[inactive_fg]="{{ colors.on_surface_variant.default.hex }}"
theme[proc_misc]="{{ colors.primary.default.hex | set_hue: 48.0 | set_saturation: 90.0 | set_lightness: 54.0 }}"

theme[cpu_box]="{{ colors.primary.default.hex | set_saturation: 70.0 | set_lightness: 64.0 }}"
theme[mem_box]="{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 50.0 }}"
theme[net_box]="{{ colors.primary.default.hex | set_hue: 140.0 | set_saturation: 78.0 | set_lightness: 48.0 }}"
theme[proc_box]="{{ colors.primary.default.hex | set_saturation: 78.0 | set_lightness: 62.0 }}"
theme[div_line]="{{ colors.outline.default.hex }}"

theme[temp_start]="{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 50.0 }}"
theme[temp_mid]="{{ colors.primary.default.hex | set_hue: 48.0 | set_saturation: 90.0 | set_lightness: 54.0 }}"
theme[temp_end]="{{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 88.0 | set_lightness: 52.0 }}"

theme[cpu_start]="{{ colors.primary.default.hex | set_hue: 140.0 | set_saturation: 78.0 | set_lightness: 48.0 }}"
theme[cpu_mid]="{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 50.0 }}"
theme[cpu_end]="{{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 88.0 | set_lightness: 52.0 }}"

theme[free_start]="{{ colors.primary.default.hex | set_hue: 140.0 | set_saturation: 78.0 | set_lightness: 48.0 }}"
theme[free_mid]="{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 50.0 }}"
theme[free_end]="{{ colors.primary.default.hex | set_hue: 215.0 | set_saturation: 80.0 | set_lightness: 55.0 }}"

theme[cached_start]="{{ colors.primary.default.hex | set_hue: 48.0 | set_saturation: 90.0 | set_lightness: 54.0 }}"
theme[cached_mid]="{{ colors.primary.default.hex | set_hue: 36.0 | set_saturation: 92.0 | set_lightness: 66.0 }}"
theme[cached_end]="{{ colors.primary.default.hex | set_saturation: 78.0 | set_lightness: 72.0 }}"

theme[available_start]="{{ colors.primary.default.hex | set_saturation: 80.0 | set_lightness: 55.0 }}"
theme[available_mid]="{{ colors.primary.default.hex | set_saturation: 78.0 | set_lightness: 62.0 }}"
theme[available_end]="{{ colors.primary.default.hex | set_saturation: 78.0 | set_lightness: 72.0 }}"

theme[used_start]="{{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 88.0 | set_lightness: 52.0 }}"
theme[used_mid]="{{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 90.0 | set_lightness: 64.0 }}"
theme[used_end]="{{ colors.primary.default.hex | set_hue: 300.0 | set_saturation: 72.0 | set_lightness: 55.0 }}"

theme[download_start]="{{ colors.primary.default.hex | set_hue: 215.0 | set_saturation: 80.0 | set_lightness: 55.0 }}"
theme[download_mid]="{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 50.0 }}"
theme[download_end]="{{ colors.primary.default.hex | set_hue: 140.0 | set_saturation: 78.0 | set_lightness: 62.0 }}"

theme[upload_start]="{{ colors.primary.default.hex | set_hue: 48.0 | set_saturation: 90.0 | set_lightness: 54.0 }}"
theme[upload_mid]="{{ colors.primary.default.hex | set_saturation: 80.0 | set_lightness: 55.0 }}"
theme[upload_end]="{{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 90.0 | set_lightness: 64.0 }}"
<* else *>
theme[main_fg]="{{ colors.on_surface.default.hex | set_lightness: 12.0 }}"
theme[title]="{{ colors.primary.default.hex | set_saturation: 80.0 | set_lightness: 44.0 }}"
theme[hi_fg]="{{ colors.primary.default.hex | set_saturation: 86.0 | set_lightness: 40.0 }}"
theme[selected_bg]="{{ colors.primary.default.hex | set_saturation: 86.0 | set_lightness: 48.0 }}"
theme[selected_fg]="{{ colors.primary.default.hex | set_saturation: 20.0 | set_lightness: 98.0 }}"
theme[inactive_fg]="{{ colors.on_surface_variant.default.hex | set_lightness: 28.0 }}"
theme[proc_misc]="{{ colors.primary.default.hex | set_hue: 36.0 | set_saturation: 90.0 | set_lightness: 36.0 }}"

theme[cpu_box]="{{ colors.primary.default.hex | set_saturation: 78.0 | set_lightness: 40.0 }}"
theme[mem_box]="{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 30.0 }}"
theme[net_box]="{{ colors.primary.default.hex | set_hue: 148.0 | set_saturation: 88.0 | set_lightness: 28.0 }}"
theme[proc_box]="{{ colors.primary.default.hex | set_saturation: 86.0 | set_lightness: 42.0 }}"
theme[div_line]="{{ colors.outline.default.hex | set_lightness: 48.0 }}"

theme[temp_start]="{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 30.0 }}"
theme[temp_mid]="{{ colors.primary.default.hex | set_hue: 36.0 | set_saturation: 90.0 | set_lightness: 36.0 }}"
theme[temp_end]="{{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 86.0 | set_lightness: 42.0 }}"

theme[cpu_start]="{{ colors.primary.default.hex | set_hue: 148.0 | set_saturation: 88.0 | set_lightness: 28.0 }}"
theme[cpu_mid]="{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 30.0 }}"
theme[cpu_end]="{{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 86.0 | set_lightness: 42.0 }}"

theme[free_start]="{{ colors.primary.default.hex | set_hue: 148.0 | set_saturation: 88.0 | set_lightness: 28.0 }}"
theme[free_mid]="{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 30.0 }}"
theme[free_end]="{{ colors.primary.default.hex | set_hue: 215.0 | set_saturation: 86.0 | set_lightness: 42.0 }}"

theme[cached_start]="{{ colors.primary.default.hex | set_hue: 36.0 | set_saturation: 90.0 | set_lightness: 36.0 }}"
theme[cached_mid]="{{ colors.primary.default.hex | set_hue: 36.0 | set_saturation: 92.0 | set_lightness: 40.0 }}"
theme[cached_end]="{{ colors.primary.default.hex | set_saturation: 80.0 | set_lightness: 44.0 }}"

theme[available_start]="{{ colors.primary.default.hex | set_saturation: 86.0 | set_lightness: 40.0 }}"
theme[available_mid]="{{ colors.primary.default.hex | set_saturation: 78.0 | set_lightness: 40.0 }}"
theme[available_end]="{{ colors.primary.default.hex | set_saturation: 80.0 | set_lightness: 44.0 }}"

theme[used_start]="{{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 86.0 | set_lightness: 42.0 }}"
theme[used_mid]="{{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 88.0 | set_lightness: 48.0 }}"
theme[used_end]="{{ colors.primary.default.hex | set_hue: 300.0 | set_saturation: 72.0 | set_lightness: 40.0 }}"

theme[download_start]="{{ colors.primary.default.hex | set_hue: 215.0 | set_saturation: 86.0 | set_lightness: 42.0 }}"
theme[download_mid]="{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 30.0 }}"
theme[download_end]="{{ colors.primary.default.hex | set_hue: 148.0 | set_saturation: 86.0 | set_lightness: 34.0 }}"

theme[upload_start]="{{ colors.primary.default.hex | set_hue: 36.0 | set_saturation: 90.0 | set_lightness: 36.0 }}"
theme[upload_mid]="{{ colors.primary.default.hex | set_saturation: 86.0 | set_lightness: 40.0 }}"
theme[upload_end]="{{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 88.0 | set_lightness: 48.0 }}"
<* endif *>
