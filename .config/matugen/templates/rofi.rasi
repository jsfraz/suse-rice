* {
    primary: {{colors.primary.default.hex}};
    primary-fixed: {{colors.primary_fixed.default.hex}};
    primary-fixed-dim: {{colors.primary_fixed_dim.default.hex}};
    on-primary: {{colors.on_primary.default.hex}};
    on-primary-fixed: {{colors.on_primary_fixed.default.hex}};
    on-primary-fixed-variant: {{colors.on_primary_fixed_variant.default.hex}};
    primary-container: {{colors.primary_container.default.hex}};
    on-primary-container: {{colors.on_primary_container.default.hex}};
    secondary: {{colors.secondary.default.hex}};
    secondary-fixed: {{colors.secondary_fixed.default.hex}};
    secondary-fixed-dim: {{colors.secondary_fixed_dim.default.hex}};
    on-secondary: {{colors.on_secondary.default.hex}};
    on-secondary-fixed: {{colors.on_secondary_fixed.default.hex}};
    on-secondary-fixed-variant: {{colors.on_secondary_fixed_variant.default.hex}};
    secondary-container: {{colors.secondary_container.default.hex}};
    on-secondary-container: {{colors.on_secondary_container.default.hex}};
    tertiary: {{colors.tertiary.default.hex}};
    tertiary-fixed: {{colors.tertiary_fixed.default.hex}};
    tertiary-fixed-dim: {{colors.tertiary_fixed_dim.default.hex}};
    on-tertiary: {{colors.on_tertiary.default.hex}};
    on-tertiary-fixed: {{colors.on_tertiary_fixed.default.hex}};
    on-tertiary-fixed-variant: {{colors.on_tertiary_fixed_variant.default.hex}};
    tertiary-container: {{colors.tertiary_container.default.hex}};
    on-tertiary-container: {{colors.on_tertiary_container.default.hex}};
    error: {{colors.error.default.hex}};
    on-error: {{colors.on_error.default.hex}};
    error-container: {{colors.error_container.default.hex}};
    on-error-container: {{colors.on_error_container.default.hex}};
    surface: {{colors.surface.default.hex}};
    on-surface: {{colors.on_surface.default.hex}};
    on-surface-variant: {{colors.on_surface_variant.default.hex}};
    outline: {{colors.outline.default.hex}};
    outline-variant: {{colors.outline_variant.default.hex}};
    shadow: {{colors.shadow.default.hex}};
    scrim: {{colors.scrim.default.hex}};
    inverse-surface: {{colors.inverse_surface.default.hex}};
    inverse-on-surface: {{colors.inverse_on_surface.default.hex}};
    inverse-primary: {{colors.inverse_primary.default.hex}};
    surface-dim: {{colors.surface_dim.default.hex}};
    surface-bright: {{colors.surface_bright.default.hex}};
    surface-container-lowest: {{colors.surface_container_lowest.default.hex}};
    surface-container-low: {{colors.surface_container_low.default.hex}};
    surface-container: {{colors.surface_container.default.hex}};
    surface-container-high: {{colors.surface_container_high.default.hex}};
    surface-container-highest: {{colors.surface_container_highest.default.hex}};

    /* Frosted Aero chrome.
       Dark mode matches the other dark templates: vivid waybar glass, white type,
       pale chips, saturated gel. Light mode stays the pale rofi reference. */
<* if {{ is_dark_mode }} *>
    foreground: {{ colors.primary.default.hex | set_saturation: 12.0 | set_lightness: 99.0 }};
    muted: {{ colors.primary.default.hex | set_saturation: 22.0 | set_lightness: 82.0 }};
    accent: {{ colors.primary.default.hex | set_saturation: 82.0 | set_lightness: 58.0 }};
    scrollbar: {{ colors.primary.default.hex | set_saturation: 42.0 | set_lightness: 82.0 }};
    gel-text: {{ colors.primary.default.hex | set_saturation: 12.0 | set_lightness: 99.0 }};
    gel-urgent-text: {{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 18.0 | set_lightness: 98.0 }};
    gel-active-text: {{ colors.primary.default.hex | set_hue: 300.0 | set_saturation: 18.0 | set_lightness: 98.0 }};
    text-hl: bold {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }};

    glass: {{ colors.primary.default.hex | set_saturation: 68.0 | set_lightness: 52.0 }}66;
    glass-input: {{ colors.primary.default.hex | set_saturation: 74.0 | set_lightness: 34.0 }}80;
    body: {{ colors.primary.default.hex | set_saturation: 74.0 | set_lightness: 34.0 }}22;
    tile: {{ colors.primary.default.hex | set_saturation: 42.0 | set_lightness: 82.0 }}33;
    gel: {{ colors.primary.default.hex | set_saturation: 82.0 | set_lightness: 58.0 }}d4;
    gel-urgent: {{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 88.0 | set_lightness: 58.0 }}d4;
    gel-active: {{ colors.primary.default.hex | set_hue: 300.0 | set_saturation: 72.0 | set_lightness: 58.0 }}d4;
    error-glass: {{ colors.error_container.default.hex }}99;

    rim-outer: {{ colors.primary.default.hex | set_saturation: 16.0 | set_lightness: 100.0 }}66;
    rim: {{ colors.primary.default.hex | set_saturation: 16.0 | set_lightness: 100.0 }}cc;
    rim-input: {{ colors.primary.default.hex | set_saturation: 18.0 | set_lightness: 98.0 }}e6;
    rim-tile: {{ colors.primary.default.hex | set_saturation: 42.0 | set_lightness: 82.0 }}55;
    rim-gel: {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}f0;

    gloss-window: linear-gradient(54deg, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}00, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}59, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}00, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}00, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}2e, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}00);
    gloss-body: linear-gradient(to bottom, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}59, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}00);
    gloss-input: linear-gradient(to bottom, {{ colors.primary.default.hex | set_saturation: 18.0 | set_lightness: 98.0 }}a3, {{ colors.primary.default.hex | set_saturation: 62.0 | set_lightness: 48.0 }}24);
    gloss-tile: linear-gradient(to bottom, {{ colors.primary.default.hex | set_saturation: 18.0 | set_lightness: 98.0 }}4d, {{ colors.primary.default.hex | set_saturation: 18.0 | set_lightness: 98.0 }}4d, {{ colors.primary.default.hex | set_saturation: 42.0 | set_lightness: 82.0 }}00, {{ colors.primary.default.hex | set_saturation: 42.0 | set_lightness: 82.0 }}00);
    gloss-gel: linear-gradient(to bottom, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}c4, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}c4, {{ colors.primary.default.hex | set_saturation: 62.0 | set_lightness: 48.0 }}66, {{ colors.primary.default.hex | set_saturation: 82.0 | set_lightness: 58.0 }}99);
<* else *>
    foreground: {{ colors.on_surface.default.hex | set_lightness: 12.0 }};
    muted: {{ colors.on_surface_variant.default.hex | set_lightness: 28.0 }};
    accent: {{ colors.primary.default.hex | set_saturation: 78.0 | set_lightness: 40.0 }};
    scrollbar: {{ colors.primary.default.hex | set_saturation: 72.0 | set_lightness: 40.0 }};
    gel-text: {{ colors.primary.default.hex | set_saturation: 20.0 | set_lightness: 98.0 }};
    gel-urgent-text: {{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 20.0 | set_lightness: 98.0 }};
    gel-active-text: {{ colors.primary.default.hex | set_hue: 300.0 | set_saturation: 20.0 | set_lightness: 98.0 }};
    text-hl: bold {{ colors.primary.default.hex | set_saturation: 80.0 | set_lightness: 36.0 }};

    glass: {{ colors.source_color.default.hex | set_saturation: 28.0 | set_lightness: 93.0 }}73;
    glass-input: {{ colors.primary.default.hex | set_saturation: 35.0 | set_lightness: 86.0 }}66;
    body: {{ colors.source_color.default.hex | set_saturation: 24.0 | set_lightness: 96.0 }}28;
    tile: {{ colors.primary.default.hex | set_saturation: 40.0 | set_lightness: 80.0 }}28;
    gel: {{ colors.primary.default.hex | set_saturation: 86.0 | set_lightness: 48.0 }}d4;
    gel-urgent: {{ colors.primary.default.hex | set_hue: 8.0 | set_saturation: 88.0 | set_lightness: 48.0 }}d4;
    gel-active: {{ colors.primary.default.hex | set_hue: 300.0 | set_saturation: 72.0 | set_lightness: 46.0 }}d4;
    error-glass: {{ colors.error_container.default.hex }}a8;

    rim-outer: {{ colors.primary.default.hex | set_saturation: 40.0 | set_lightness: 100.0 }}99;
    rim: {{ colors.primary.default.hex | set_saturation: 40.0 | set_lightness: 100.0 }}cc;
    rim-input: {{ colors.primary.default.hex | set_saturation: 20.0 | set_lightness: 100.0 }}e6;
    rim-tile: {{ colors.primary.default.hex | set_saturation: 50.0 | set_lightness: 70.0 }}4d;
    rim-gel: {{ colors.primary.default.hex | set_saturation: 15.0 | set_lightness: 100.0 }}f0;

    gloss-window: linear-gradient(54deg, {{ colors.primary.default.hex | set_saturation: 10.0 | set_lightness: 100.0 }}00, {{ colors.primary.default.hex | set_saturation: 10.0 | set_lightness: 100.0 }}73, {{ colors.primary.default.hex | set_saturation: 10.0 | set_lightness: 100.0 }}00, {{ colors.primary.default.hex | set_saturation: 10.0 | set_lightness: 100.0 }}00, {{ colors.primary.default.hex | set_saturation: 10.0 | set_lightness: 100.0 }}40, {{ colors.primary.default.hex | set_saturation: 10.0 | set_lightness: 100.0 }}00);
    gloss-body: linear-gradient(to bottom, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}73, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}00);
    gloss-input: linear-gradient(to bottom, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}c4, {{ colors.primary.default.hex | set_saturation: 40.0 | set_lightness: 82.0 }}2e);
    gloss-tile: linear-gradient(to bottom, {{ colors.primary.default.hex | set_saturation: 10.0 | set_lightness: 100.0 }}66, {{ colors.primary.default.hex | set_saturation: 10.0 | set_lightness: 100.0 }}66, {{ colors.primary.default.hex | set_saturation: 30.0 | set_lightness: 80.0 }}00, {{ colors.primary.default.hex | set_saturation: 30.0 | set_lightness: 80.0 }}00);
    gloss-gel: linear-gradient(to bottom, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}d9, {{ colors.primary.default.hex | set_saturation: 8.0 | set_lightness: 100.0 }}d9, {{ colors.primary.default.hex | set_saturation: 50.0 | set_lightness: 72.0 }}66, {{ colors.primary.default.hex | set_saturation: 86.0 | set_lightness: 48.0 }}99);
<* endif *>
}
