{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "small",
      "color": {
<* if {{ is_dark_mode }} *>
        "1": "{{ colors.primary.default.hex | set_saturation: 80.0 | set_lightness: 55.0 }}",
        "2": "{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 50.0 }}"
<* else *>
        "1": "{{ colors.primary.default.hex | set_saturation: 86.0 | set_lightness: 40.0 }}",
        "2": "{{ colors.primary.default.hex | set_hue: 185.0 | set_saturation: 82.0 | set_lightness: 30.0 }}"
<* endif *>
      },
      "padding": {
        "top": 1,
        "left": 3
      }
    },
    "display": {
      "separator": " \uf460 ",
      "constants": [
        "──────────"
      ],
      "key": {
        "type": "icon"
      },
      "color": {
<* if {{ is_dark_mode }} *>
        "keys": "{{ colors.primary.default.hex | set_hue: 140.0 | set_saturation: 78.0 | set_lightness: 48.0 }}",
        "title": "{{ colors.primary.default.hex | set_saturation: 78.0 | set_lightness: 72.0 }}"
<* else *>
        "keys": "{{ colors.primary.default.hex | set_hue: 148.0 | set_saturation: 88.0 | set_lightness: 28.0 }}",
        "title": "{{ colors.primary.default.hex | set_saturation: 80.0 | set_lightness: 44.0 }}"
<* endif *>
      }
    },
    "modules": [
      "title",
      {
        "type": "custom",
        "format": "{$1}"
      },
      "os",
      "uptime",
      "cpu",
      {
        "type": "gpu",
        "format": "{name}"
      },
      {
        "type": "memory",
        "percent": {
          "type": 3
        }
      },
      {
        "type": "disk",
        "percent": {
          "type": 0
        }
      },
      "break",
      {
        "type": "colors",
        "symbol": "circle"
      }
    ]
  }
