{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 10,
    "margin-right": 10,
    "margin-bottom": 0,
    "margin-left": 10,
    "spacing": 5,
    "exclusive": true,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/os"
    ],
    "modules-right": [
        "tray",
        "custom/runcat",
        "custom/net",
        "custom/workspace",
        "battery",
        "clock"
    ],
    "tray": {
        "icon-size": 21,
        "spacing": 5
    },
    "custom/os": {
        "exec": "~/.config/waybar/scripts/os-icon.sh",
        "return-type": "json",
        "interval": "once",
        "tooltip": false
    },
    "custom/runcat": {
        "exec": "~/.config/waybar/scripts/runcat.sh",
        "return-type": "json"
    },
    "custom/net": {
        "exec": "~/.config/waybar/scripts/network.sh",
        "return-type": "json",
        "interval": 2
    },
    "custom/workspace": {
        "exec": "~/.config/waybar/scripts/workspace.sh",
        "return-type": "json",
        "tooltip": false
    },
    "battery": {
        "interval": 5,
        "format": "{icon}",
        "format-charging": "{icon}",
        "format-plugged": "{icon}",
        "format-full": "{icon}",
        "tooltip-format": "{capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "states": {
            "warning": 20,
            "critical": 15
        }
    },
    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S}",
        "tooltip": false
    }
}
