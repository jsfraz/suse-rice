{
    "layer": "top",
    "position": "top",
    "height": 35,
    "margin-top": 10,
    "margin-right": 10,
    "margin-bottom": 0,
    "margin-left": 10,
    "spacing": 2,
    "exclusive": true,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/os"
    ],
    "modules-center": [
        "cffi/clock"
    ],
    "modules-right": [
        "tray",
        "cffi/workspace",
        "custom/runcat",
        "network",
        "battery"
    ],
    "tray": {
        "icon-size": 18,
        "spacing": 10,
        "show-passive-items": true,
        "icons": {
            "kdeconnect-indicator": "/usr/share/icons/hicolor/scalable/apps/kdeconnectindicator.svg",
            "org.kde.kdeconnect-indicator": "/usr/share/icons/hicolor/scalable/apps/kdeconnectindicator.svg",
            "org.localsend.localsend_app": "/var/lib/flatpak/app/org.localsend.localsend_app/current/active/files/share/icons/hicolor/32x32/apps/org.localsend.localsend_app-tray.png"
        }
    },
    "custom/os": {
        "exec": "~/.config/waybar/scripts/os-icon.sh",
        "return-type": "json",
        "interval": "once",
        "tooltip": false,
        "format": " ",
        "on-click": "~/.config/quickshell/scripts/app-launcher.sh"
    },
    "custom/runcat": {
        "exec": "~/.config/waybar/scripts/runcat.sh",
        "return-type": "json",
        "format": " "
    },
    "network": {
        "interval": 2,
        "format-wifi": "{icon}",
        "format-ethernet": "{icon}",
        "format-linked": "{icon}",
        "format-disconnected": "{icon}",
        "format-disabled": "{icon}",
        "tooltip-format-wifi": "{signalStrength}%",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "No connection",
        "tooltip-format-disabled": "Disabled",
        "format-icons": {
            "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
            "ethernet": "󰈀",
            "linked": "󰈂",
            "disconnected": "󰤭",
            "disabled": "󰤭"
        }
    },
    "cffi/workspace": {
        "module_path": "/home/razj/.config/waybar/cffi/libslides.so",
        "kind": "workspace",
        "tooltip": false
    },
    "battery": {
        "interval": 5,
        "format": "{icon}",
        "format-charging": "{icon}",
        "format-plugged": "{icon}",
        "format-full": "{icon}",
        "tooltip-format": "{capacity}%",
        "format-icons": {
            "default": [
                "󰂃",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ],
            "discharging": [
                "󰂃",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ],
            "charging": [
                "󰂆",
                "󰂆",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰂈",
                "󰂉",
                "󰂉",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "plugged": "󰁹",
            "full": "󰁹"
        },
        "states": {
            "warning": 20,
            "critical": 15
        },
        "events": {
            "on-discharging-critical": "notify-send -u critical -i battery-low \"Low Battery\" \"Battery level is at $(cat /sys/class/power_supply/BAT*/capacity | head -1)%\"",
            "on-charging-100": "notify-send -u normal -i battery-full-charged \"Battery Fully Charged\" \"Battery is at 100%\""
        }
    },
    "cffi/clock": {
        "module_path": "/home/razj/.config/waybar/cffi/libslides.so",
        "kind": "clock",
        "tooltip": false
    }
}
