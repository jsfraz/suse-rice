/**
 * Frosted Aero launcher — kitty-matched glass, gel tiles, matugen light/dark.
 **/

/*****----- Configuration -----*****/
configuration {
    modi:                       "combi";
    combi-modi:                 "drun,ssh";
    show-icons:                 true;
    display-combi:              "";
    display-drun:               "";
    display-ssh:                "";
    drun-display-format:        "{name}";
    /* Wheel follows the row (L→R), not the column. */
    ml-row-up:                  "";
    ml-row-down:                "";
    ml-row-left:                "ScrollUp";
    ml-row-right:               "ScrollDown";
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

@import                          "colors.rasi"

* {
    font:                        "Source Sans 3 13";
}

/*****----- Main Window (glass frame) -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       820px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px 1px 1px 1px;
    border-radius:               16px;
    border-color:                @rim;
    background-color:            @glass;
    background-image:            @gloss-window;
    cursor:                      "default";
}

/*****----- Main Box (inner white highlight) -----*****/
mainbox {
    enabled:                     true;
    spacing:                     8px;
    margin:                      2px;
    padding:                     8px 8px 10px 8px;
    border:                      1px;
    border-radius:               14px;
    border-color:                @rim;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "body" ];
}

/*****----- Inputbar (Aero search field) -----*****/
inputbar {
    enabled:                     true;
    expand:                      false;
    spacing:                     8px;
    margin:                      0px;
    padding:                     8px 12px;
    border:                      1px;
    border-radius:               12px;
    border-color:                @rim-input;
    background-color:            @glass-input;
    background-image:            @gloss-input;
    text-color:                  @foreground;
    children:                    [ "textbox-icon", "entry" ];
}

textbox-icon {
    enabled:                     true;
    expand:                      false;
    str:                         "⌕";
    font:                        "Source Sans 3 14";
    background-color:            transparent;
    text-color:                  @accent;
    vertical-align:              0.5;
}
prompt {
    enabled:                     true;
    font:                        "Source Sans 3 14";
    background-color:            transparent;
    text-color:                  @accent;
    vertical-align:              0.5;
}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "::";
    background-color:            transparent;
    text-color:                  inherit;
}
entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Search";
    placeholder-color:           @muted;
    cursor-color:                @accent;
}

/*****----- Body (window-body surface) -----*****/
body {
    enabled:                     true;
    expand:                      true;
    orientation:                 vertical;
    spacing:                     0px;
    margin:                      0px;
    padding:                     8px;
    border:                      1px;
    border-radius:               10px;
    border-color:                @rim;
    background-color:            @body;
    background-image:            @gloss-body;
    children:                    [ "listview" ];
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     5;
    lines:                       3;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    flow:                        horizontal;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     8px;
    margin:                      0px;
    padding:                     2px;
    border:                      0px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}
scrollbar {
    handle-width:                6px;
    handle-color:                @scrollbar;
    border-radius:               3px;
    background-color:            @tile;
}

/*****----- Elements (Aero gel buttons) -----*****/
element {
    enabled:                     true;
    spacing:                     8px;
    margin:                      0px;
    padding:                     14px 8px 10px 8px;
    border:                      1px;
    border-radius:               8px;
    border-color:                @rim-tile;
    background-color:            @tile;
    background-image:            @gloss-tile;
    text-color:                  @foreground;
    orientation:                 vertical;
    cursor:                      pointer;
}
element normal.normal,
element alternate.normal {
    background-color:            @tile;
    background-image:            @gloss-tile;
    border-color:                @rim-tile;
    text-color:                  @foreground;
}
element selected.normal {
    background-color:            @gel;
    background-image:            @gloss-gel;
    border:                      2px 1px 1px 1px;
    border-radius:               8px;
    border-color:                @rim-gel;
    text-color:                  @gel-text;
}
element selected.urgent {
    background-color:            @gel-urgent;
    background-image:            @gloss-gel;
    border:                      2px 1px 1px 1px;
    border-radius:               8px;
    border-color:                @rim-gel;
    text-color:                  @gel-urgent-text;
}
element selected.active {
    background-color:            @gel-active;
    background-image:            @gloss-gel;
    border:                      2px 1px 1px 1px;
    border-radius:               8px;
    border-color:                @rim-gel;
    text-color:                  @gel-active-text;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        64px;
    cursor:                      inherit;
    horizontal-align:            0.5;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   @text-hl;
    cursor:                      inherit;
    font:                        "Source Sans 3 Medium 11";
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     8px 12px;
    border:                      1px;
    border-radius:               10px;
    background-image:            @gloss-body;
    text-color:                  @foreground;
}
error-message {
    padding:                     12px 16px;
    border:                      1px;
    border-radius:               8px;
    border-color:                @rim;
    background-color:            @error-glass;
    background-image:            @gloss-window;
    text-color:                  @on-error-container;
}
textbox {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
}
